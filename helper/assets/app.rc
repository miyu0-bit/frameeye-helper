FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "FrameEye Helper"
      VALUE "FileDescription", "FrameEye Helper - Steam Frame eye tracking for VRChat"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "FrameEyeHelper"
      VALUE "OriginalFilename", "FrameEyeHelper.exe"
      VALUE "ProductName", "FrameEye Helper"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
